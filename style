/* Компактный стиль для модуля 2ГИС */
.callout._module_firmCallout {
    padding: 12px !important;
    font-size: 13px !important;
    background: var(--color-background-secondary) !important;
    border-radius: var(--border-radius-lg) !important;
    border: 1px solid var(--color-border-tertiary) !important;
}

/* Скрываем список оплаты и фото, чтобы не занимали место */
.callout__payment, 
.callout__photo, 
.callout__addressComment {
    display: none !important;
}

/* Уменьшаем заголовки и текст */
.callout__address {
    font-weight: 600 !important;
    margin-bottom: 4px !important;
    font-size: 14px !important;
}

.callout__phone {
    font-weight: 700 !important;
    color: var(--color-primary) !important;
    margin-bottom: 8px !important;
}

.callout__scheduleToday {
    font-size: 12px !important;
    text-decoration: none !important;
    color: var(--color-text-secondary) !important;
}

/* Кнопки в одну строку */
.callout__footer {
    margin-top: 10px !important;
    padding-top: 10px !important;
    border-top: 1px solid var(--color-border-tertiary) !important;
    display: flex !important;
    gap: 8px !important;
    flex-wrap: wrap !important;
}

.callout__btn, .fromTo__btn {
    background: var(--color-primary) !important;
    color: #fff !important;
    padding: 6px 12px !important;
    border-radius: 8px !important;
    font-size: 11px !important;
    text-align: center !important;
    text-decoration: none !important;
    flex: 1 !important;
    min-width: 80px !important;
}

.callout__btnIn, .fromTo__btn {
    color: #fff !important;
}

.callout__scheduleStatus {
    font-size: 11px !important;
    color: #e53935 !important; /* Цвет для статуса "Закрыто" */
}
